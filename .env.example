# Environment Variables for mini-swe-agent with AContext Integration
#
# Copy this file to .env and fill in your values.

# === LLM Configuration ===
# Anthropic API key for Claude models
ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenAI API key (if using OpenAI models)
# OPENAI_API_KEY=your-openai-api-key

# === AContext Configuration ===
# AContext API key (required for AContext features)
ACONTEXT_API_KEY=sk-ac-your-root-api-bearer-token

# AContext server URL (default: http://localhost:8029/api/v1)
ACONTEXT_BASE_URL=http://localhost:8029/api/v1

# === mini-swe-agent Configuration ===
# Default model to use
# MSWEA_MODEL_NAME=anthropic/claude-sonnet-4-5-20250929

# Suppress startup message
# MSWEA_SILENT_STARTUP=1

# Visual mode default (false = use interactive agent, true = use textual agent)
# MSWEA_VISUAL_MODE_DEFAULT=false
